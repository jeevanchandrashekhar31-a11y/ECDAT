{
  "name": "ecdat-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Cryptographic Discovery and Assessment Tool",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "sbom": "python scripts/generate_sbom.py",
    "vuln-scan": "python scripts/scan_vulnerabilities.py",
    "security:audit": "npm run vuln-scan",
    "sign": "python scripts/sign_artifacts.py",
    "provenance": "python scripts/generate_provenance.py",
    "release-gate": "python scripts/release_gate.py",
    "security-gate": "python scripts/security_gate.py",
    "evidence:verify": "python scripts/generate_security_evidence.py --verify",
    "clear-data": "npm --prefix backend run clear-data"
  }
}
