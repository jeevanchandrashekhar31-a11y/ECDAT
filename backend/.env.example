# ECDAT Backend Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.

# Server Environment
NODE_ENV=development
PORT=5000

# Request Limits
MAX_JSON_SIZE=10mb
MAX_UPLOAD_BYTES=10485760
UPLOAD_RATE_LIMIT=60

# Cross-Origin Resource Sharing (comma-separated origins, no wildcards when credentials enabled)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecdat

# API access (required when NODE_ENV=production; never commit a real key)
ECDAT_API_KEY=replace-with-a-strong-local-development-key
REQUIRE_AUTH_FOR_READS=false
REQUIRE_DATABASE_HEALTH=false

# Risk Engine Defaults
DEFAULT_POLICY_PROFILE=internal_enterprise
DEFAULT_SCENARIO=baseline
