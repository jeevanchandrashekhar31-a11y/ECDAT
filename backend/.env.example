# ECDAT Backend Environment Configuration Template
# Copy this file to .env and supply values via environment injection.
# Never commit actual credentials or secrets to source control.

# Server Environment
NODE_ENV=development
PORT=5000
AUTH_MODE=production

# Database Connection (PostgreSQL)
DATABASE_URL=

# Cryptographic Security & Authentication (Placeholders only)
API_KEY=
ECDAT_API_KEY=
AUTH_SECRET=
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Security & Access Controls
REQUIRE_AUTH_FOR_READS=true
REQUIRE_DATABASE_HEALTH=false
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Request Limits
MAX_JSON_SIZE=10mb
MAX_UPLOAD_BYTES=10485760
UPLOAD_RATE_LIMIT=60

# Risk Engine Defaults
DEFAULT_POLICY_PROFILE=internal_enterprise
DEFAULT_SCENARIO=baseline
