# ==============================================================================
# ECDAT SANITIZED EXAMPLE CONFIGURATION — CLEAN ENVIRONMENT
# ==============================================================================
# This file records all required environment variables with sanitized, synthetic
# values suitable for running reproducible clean-environment security verification.
#
# Hardening Guarantees:
# - No real secrets, production credentials, or developer tokens are present.
# - All keys satisfy length (>= 32 chars) and entropy validation standards.
# - Does not rely on ambient developer machine state or pre-existing databases.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=test
APP_ENV=test
ECDAT_ENV=test
PORT=5000
CORS_ORIGIN=https://ecdat.example.internal:3000

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy synthetic API key (never commit real production keys)
ECDAT_API_KEY=ecdat_clean_api_key_0123456789abcdef0123456789abcdef

# Master 256-bit AES key for database encryption at rest (64 hex characters = 256 bits)
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret key for JWT authentication and session token verification
JWT_SECRET=jwt_clean_session_secret_0123456789abcdef0123456789abcdef

# Mandatory authentication requirement for all data reads
REQUIRE_AUTH_FOR_READS=true

# ------------------------------------------------------------------------------
# 3. DATABASE & TRANSIT ENCRYPTION
# ------------------------------------------------------------------------------
# Isolated test database URL (or in-memory mock connection)
DATABASE_URL=postgresql://ecdat_clean_user:ecdat_clean_pass_0123456789@localhost:5432/ecdat_clean_db
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
REQUIRE_DATABASE_HEALTH=false

# ------------------------------------------------------------------------------
# 4. AUDIT & SIEM CRYPTOGRAPHIC HMAC SIGNING
# ------------------------------------------------------------------------------
# Cryptographic key for tamper-evident hash chain verification
AUDIT_HMAC_SECRET=audit_tamper_chain_secret_0123456789abcdef0123456789abcdef

# Cryptographic HMAC key for SIEM event dispatching
SIEM_HMAC_SECRET=siem_hmac_event_signing_key_0123456789abcdef0123456789abcdef

# Webhook secret for receiver authentication
SIEM_WEBHOOK_SECRET=siem_webhook_secret_key_0123456789abcdef0123456789abcdef

# Cryptographic signature verification key for policy bundles
ECDAT_POLICY_SIGNING_KEY=policy_signing_key_0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 5. RESOURCE LIMITS & INPUT GOVERNANCE
# ------------------------------------------------------------------------------
MAX_JSON_SIZE=10mb
MAX_UPLOAD_BYTES=10485760
UPLOAD_RATE_LIMIT=60
MAX_SBOM_COMPONENTS=50000
MAX_CBOM_COMPONENTS=50000

# ------------------------------------------------------------------------------
# 6. DATA RETENTION POLICY
# ------------------------------------------------------------------------------
RETENTION_SCANS_DAYS=90
RETENTION_SCAN_ERRORS_DAYS=30
RETENTION_AUDIT_LOGS_DAYS=365

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
FRONTEND_PORT=3000
