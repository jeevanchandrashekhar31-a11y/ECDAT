{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuntimeProbesCatalog",
  "type": "object",
  "required": ["version", "description", "last_updated", "metadata_only_rules", "supported_libraries"],
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "metadata_only_rules": {
      "type": "object",
      "required": ["strictly_forbidden_fields", "allowed_metadata_fields"],
      "properties": {
        "strictly_forbidden_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_metadata_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "security_boundary": {
      "type": "object",
      "properties": {
        "privilege_isolation": { "type": "object" },
        "resource_limits": { "type": "object" },
        "kernel_compatibility": { "type": "object" }
      }
    },
    "supported_libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["library_id", "library_name", "probes"],
        "properties": {
          "library_id": { "type": "string" },
          "library_name": { "type": "string" },
          "probes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["probe_id", "function_name", "crypto_operation", "captured_parameters"],
              "properties": {
                "probe_id": { "type": "string" },
                "function_name": { "type": "string" },
                "crypto_operation": { "type": "string" },
                "captured_parameters": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
