{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyProfilesSchema",
  "description": "Schema for environmental and compliance policy profiles in ECDAT.",
  "type": "object",
  "required": [
    "version",
    "description",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "required": [
        "ecdat_enterprise_baseline",
        "nist_crypto_transition",
        "pci_dss_v4_0_1",
        "india_financial_services_composite",
        "us_federal_cloud_fedramp",
        "cnsa_2_0_nss",
        "ot_ics_high_assurance"
      ],
      "additionalProperties": true,
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "required": [
            "id",
            "name",
            "type",
            "jurisdiction",
            "scope",
            "source_documents",
            "version",
            "effective_date",
            "status",
            "algorithm_rules",
            "key_length_rules",
            "pqc_rules",
            "certificate_rules",
            "protocol_rules",
            "notes",
            "is_custom"
          ],
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "official_standard",
                "composite",
                "ecdat_custom"
              ]
            },
            "jurisdiction": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "source_documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string"
            },
            "effective_date": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "algorithm_rules": {
              "type": "object"
            },
            "key_length_rules": {
              "type": "object"
            },
            "pqc_rules": {
              "type": "object"
            },
            "certificate_rules": {
              "type": "object"
            },
            "protocol_rules": {
              "type": "object"
            },
            "notes": {
              "type": "string"
            },
            "is_custom": {
              "type": "boolean"
            },
            "cicd_fail_threshold": {
              "type": "string"
            },
            "severity_score_thresholds": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}