{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PolicyProfilesSchema",
  "description": "Schema for environmental and compliance policy profiles in ECDAT.",
  "type": "object",
  "required": ["version", "description", "profiles"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "required": [
        "public_internet",
        "internal_enterprise",
        "regulated_bfsi",
        "government_high_value",
        "iot_ot"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "required": [
            "name",
            "description",
            "default_data_sensitivity",
            "default_business_criticality",
            "tls_policy",
            "key_size_policy",
            "certificate_policy",
            "pqc_policy",
            "cicd_fail_threshold",
            "severity_score_thresholds"
          ],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "default_data_sensitivity": {
              "type": "string",
              "enum": ["public", "internal", "confidential", "restricted"]
            },
            "default_business_criticality": {
              "type": "string",
              "enum": ["low", "medium", "high", "critical"]
            },
            "tls_policy": {
              "type": "object",
              "required": ["minimum_version", "allowed_versions", "prohibited_versions"],
              "additionalProperties": false,
              "properties": {
                "minimum_version": { "type": "string" },
                "allowed_versions": { "type": "array", "items": { "type": "string" } },
                "prohibited_versions": { "type": "array", "items": { "type": "string" } }
              }
            },
            "key_size_policy": {
              "type": "object",
              "required": ["min_rsa_bits", "min_ecc_bits", "allowed_ecc_curves", "min_dh_bits"],
              "additionalProperties": false,
              "properties": {
                "min_rsa_bits": { "type": "integer", "minimum": 1024 },
                "min_ecc_bits": { "type": "integer", "minimum": 160 },
                "allowed_ecc_curves": { "type": "array", "items": { "type": "string" } },
                "min_dh_bits": { "type": "integer", "minimum": 1024 }
              }
            },
            "certificate_policy": {
              "type": "object",
              "required": [
                "allow_self_signed",
                "allow_self_signed_with_exception",
                "max_validity_days"
              ],
              "additionalProperties": false,
              "properties": {
                "allow_self_signed": { "type": "boolean" },
                "allow_self_signed_with_exception": { "type": "boolean" },
                "max_validity_days": { "type": "integer", "minimum": 1 },
                "require_ct_logs": { "type": "boolean" }
              }
            },
            "pqc_policy": {
              "type": "object",
              "required": [
                "mandatory_migration_deadline_year",
                "urgency_mosca_delta_threshold_years",
                "prefer_hybrid"
              ],
              "additionalProperties": false,
              "properties": {
                "mandatory_migration_deadline_year": { "type": "integer", "minimum": 2025 },
                "urgency_mosca_delta_threshold_years": { "type": "number" },
                "prefer_hybrid": { "type": "boolean" },
                "target_pqc_standards": { "type": "array", "items": { "type": "string" } }
              }
            },
            "cicd_fail_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low", "none"]
            },
            "severity_score_thresholds": {
              "type": "object",
              "required": ["critical", "high", "medium", "low"],
              "additionalProperties": false,
              "properties": {
                "critical": { "type": "number", "minimum": 0, "maximum": 100 },
                "high": { "type": "number", "minimum": 0, "maximum": 100 },
                "medium": { "type": "number", "minimum": 0, "maximum": 100 },
                "low": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      }
    }
  }
}
