###############################################################
# ECDAT — Environment Configuration
# Copy this to .env and fill in real values before running
###############################################################

# ─── Core ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
AUTH_MODE=demo

# ─── Database — Neon Serverless PostgreSQL ────────────────────
# Get your connection string from: https://neon.tech (free tier)
# Format: postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require
DATA_STORE_MODE=postgres
REQUIRE_DATABASE_HEALTH=true

# ─── Redis — Sessions, Rate Limiting, Cache ───────────────────
# Local Docker Redis (default when using docker compose):
REDIS_URL=redis://:ecdat-redis-secret@localhost:6379
# For production, use Upstash Redis (free): https://upstash.com
# REDIS_URL=rediss://:your-token@your-endpoint.upstash.io:6380

# ─── Security ─────────────────────────────────────────────────
# IMPORTANT: Generate real secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-in-production-use-256bit-random
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
REDIS_PASSWORD=ecdat-redis-secret

# ─── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://your-domain.com

# ─── Scanners ─────────────────────────────────────────────────
SCAN_ARTIFACTS_DIR=./artifacts
PYTHONPATH=.

# ─── Optional: OIDC (Okta / Auth0 / Azure AD) ─────────────────
# Uncomment and fill when you have an IDP:
# OIDC_ISSUER_URL=https://dev-xxx.okta.com/oauth2/default
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=https://your-domain.com/api/v1/auth/oidc/callback

# ─── Optional: LDAP / Active Directory ────────────────────────
# LDAP_URL=ldap://your-ad-server:389
# LDAP_BASE_DN=DC=yourcompany,DC=com
# LDAP_BIND_DN=CN=ecdat-svc,OU=ServiceAccounts,DC=yourcompany,DC=com
# LDAP_BIND_PASSWORD=your-service-account-password
